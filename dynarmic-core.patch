-	int rd = (opcode >> 12) & 0xF;
-	ARM_PC_DEST(rd);
-	int rm = opcode & 0xF;
-	uint32_t value = cpu->gprs[rm];
-	cpu->gprs[rd] = value ? __builtin_clz(value) : 32;)
