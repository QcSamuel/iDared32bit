-static bool neon_modified_imm(struct touchHLE_Vfp *vfp, uint32_t opcode) {
-  unsigned cmode = (opcode >> 8) & 0xF;
-  unsigned op = (opcode >> 5) & 1;
-  bool q = NEON_Q;
-  int d = NEON_VD;
-  unsigned imm8 = (((opcode >> 24) & 1) << 7) | (((opcode >> 16) & 7) << 4) |
-                  (opcode & 0xF);
-  unsigned regs = q ? 2 : 1;
-  uint64_t imm;
-
-  if (q && (d & 1)) {
-    return false;
-  }
-  if (!expand_imm(op, cmode, imm8, &imm)) {
-    return false;
