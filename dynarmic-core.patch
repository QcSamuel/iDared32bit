-    if ((n | m) & 1) {
-      return false;
-    }
-    read_regs(vfp, n, 2, vn);
-    read_regs(vfp, m, 2, vm);
-    out[0] = 0;
-    for (unsigned e = 0; e < elements; e++) {
-      uint64_t x = elem(vn, e, wide), y = elem(vm, e, wide);
-      uint64_t r = a == 4 ? x + y : x - y;
-      if (u) {
-        r += 1ull << (esize - 1);
-      }
-      set_elem(out, e, esize, (r & ones(wide)) >> esize);
-    }
-    vfp->regs.d[d] = out[0];
