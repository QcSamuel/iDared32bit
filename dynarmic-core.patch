-    uint64_t *reg = &vfp->regs.d[d + r];
-    if (logical) {
-      *reg = op ? *reg & ~imm : *reg | imm;
-    } else {
-      *reg = invert ? ~imm : imm;
-    }
-  }
-  return true;
-}
