-	case 0:
-		return THUMB2_LSL;
-	case 1:
-		*amount = imm5 ? imm5 : 32;
-		return THUMB2_LSR;
-	case 2:
-		*amount = imm5 ? imm5 : 32;
-		return THUMB2_ASR;
-	default:
-		if (!imm5) {
-			*amount = 1;
-			return THUMB2_RRX;
-		}
-		return THUMB2_ROR;
-	}
-}
