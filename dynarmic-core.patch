-      break;
-    case 7: /* VABDL */
-      r = (uint64_t)(x > y ? x - y : y - x);
-      break;
-    case 8: /* VMLAL */
-      r = acc + (uint64_t)x * (uint64_t)y;
-      break;
-    case 0xA: /* VMLSL */
-      r = acc - (uint64_t)x * (uint64_t)y;
-      break;
-    case 0xC: /* VMULL */
-      r = (uint64_t)x * (uint64_t)y;
-      break;
-    case 9: /* VQDMLAL */
