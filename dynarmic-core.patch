-    if (m & 1) {
-      return false;
-    }
-    bool round = q;
-    bool src_unsigned = a == 9 && u;
-    bool saturate = a == 9 || u;
-    bool dst_unsigned = u;
-    read_regs(vfp, m, 2, vm);
-    for (unsigned e = 0; e < 64 / esize; e++) {
