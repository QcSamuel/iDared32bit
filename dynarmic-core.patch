-	0xCCCC, // CS [--C-]
-	0x3333, // CC [--c-]
-	0xFF00, // MI [N---]
-	0x00FF, // PL [n---]
-	0xAAAA, // VS [---V]
-	0x5555, // VC [---v]
-	0x0C0C, // HI [-zC-]
-	0xF3F3, // LS [-Z--] || [--c-]
-	0xAA55, // GE [N--V] || [n--v]
-	0x55AA, // LT [N--v] || [n--V]
-	0x0A05, // GT [Nz-V] || [nz-v]
-	0xF5FA, // LE [-Z--] || [Nz-v] || [nz-V]
-	0xFFFF, // AL [----]
-	0x0000 // NV
