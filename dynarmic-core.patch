-  unsigned a = (opcode >> 8) & 0xF;
-  bool u = NEON_U;
-  unsigned size = NEON_SIZE;
-  int d = NEON_VD, n = NEON_VN, m = NEON_VM;
-  unsigned esize = 8u << size;
-  unsigned wide = 2 * esize;
-  unsigned elements = 64 / esize;
