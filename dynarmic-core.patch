-		logical = false;
-		break;
-	case 0xD:
-		result = _thumb2AddWithCarry(cpu, n, ~operand, 1, s);
-		logical = false;
-		break;
-	case 0xE:
-		result = _thumb2AddWithCarry(cpu, ~n, operand, 1, s);
-		logical = false;
-		break;
