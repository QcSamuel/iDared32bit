-  if (wide_n && (n & 1)) {
-    return false;
-  }
-  if ((a == 9 || a == 0xB || a == 0xD) && (u || size == 0)) {
-    return false;
-  }
-  if (a == 0xE && (u || size != 0)) {
-    return false;
