-/* Run an ARM encoding, built with an AL condition, through the ARM table. */
-static void _thumb2RunARM(struct ARMCore* cpu, uint32_t arm) {
-	_armTable[((arm >> 16) & 0xFF0) | ((arm >> 4) & 0x00F)](cpu, arm);
-}
