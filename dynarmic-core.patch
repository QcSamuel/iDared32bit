-/* DecodeImmShift: an immediate of zero means 32 for LSR and ASR, and RRX
- * for ROR. */
-static enum Thumb2Shift _thumb2DecodeImmShift(unsigned type, unsigned imm5, unsigned* amount) {
-	*amount = imm5;
