-  unsigned index;
-  if (size == 1) {
-    m = (int)(opcode & 7);
-    index = (((opcode >> 5) & 1) << 1) | ((opcode >> 3) & 1);
-  } else {
-    m = (int)(opcode & 0xF);
-    index = (opcode >> 5) & 1;
-  }
-  uint64_t scalar = elem(&vfp->regs.d[m], index, esize);
-
-  if (is_long) {
-    if (d & 1) {
-      return false;
-    }
-    uint64_t vn[1], vd[2], out[2] = {0, 0};
-    unsigned wide = 2 * esize;
-    read_regs(vfp, n, 1, vn);
-    read_regs(vfp, d, 2, vd);
