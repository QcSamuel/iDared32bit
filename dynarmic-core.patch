-void ARMInitStrictTable(void) {
-	unsigned i;
-	for (i = 0; i < 0x1000; ++i) {
-		_armStrictTable[i] = (uint8_t) _armStrictKind(((i & 0xFF0) << 16) | ((i & 0xF) << 4));
-	}
-}
