-#define STRICT_FIELD(HI, LO) ((opcode >> (LO)) & ((1u << ((HI) - (LO) + 1)) - 1))
-#define STRICT_ONES(HI, LO) ((1u << ((HI) - (LO) + 1)) - 1)
