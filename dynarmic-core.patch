-                          : a == 8   ? OP_MUL
-                          : a == 0xC ? OP_QDMULH
-                                     : OP_QRDMULH;
-    for (unsigned e = 0; e < elements; e++) {
-      set_elem(out, e, esize,
-               int_op(vfp, op, elem(vn, e, esize), scalar, elem(vd, e, esize),
-                      esize, false));
-    }
-  }
